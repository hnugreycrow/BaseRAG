# Local development only. Copy to .env; do not commit .env.
POSTGRES_USER=jagent
POSTGRES_PASSWORD=jagent-local-change-me
DB_URL=jdbc:postgresql://localhost:5432/jagent
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=jagent-local
RUSTFS_SECRET_KEY=jagent-local-secret-change-me
RUSTFS_BUCKET=jagent
# AI provider credentials. Provider URLs, endpoints and model candidates live in application.yaml.
BAILIAN_API_KEY=
SILICONFLOW_API_KEY=
# Qwen3-Embedding supports configurable output dimensions; existing knowledge bases must keep this value stable.
EMBEDDING_DIMENSIONS=1536
