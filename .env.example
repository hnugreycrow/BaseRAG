# Local development only. Copy to .env; do not commit .env.
POSTGRES_USER=baserag
POSTGRES_PASSWORD=baserag-local-change-me
DB_URL=jdbc:postgresql://localhost:5432/baserag
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=baserag-redis-local-change-me
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=baserag-local
RUSTFS_SECRET_KEY=baserag-local-secret-change-me
RUSTFS_BUCKET=baserag
# AI provider credentials. Provider URLs, endpoints and model candidates live in application.yaml.
DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
# Optional: override only Bailian Embedding; Chat/Rerank continue using ai.providers.bailian.url.
BAILIAN_EMBEDDING_BASE_URL=
SILICONFLOW_API_KEY=
# Required only when the database has not yet initialized its first real user.
BASERAG_ADMIN_USERNAME=admin
BASERAG_ADMIN_DISPLAY_NAME=BaseRAG 管理员
BASERAG_ADMIN_PASSWORD=change-this-admin-password
